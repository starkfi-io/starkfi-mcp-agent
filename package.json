{
  "name": "starkfi-mcp",
  "version": "1.0.1",
  "description": "MCP server for StarkFi API (api.starkfi.io)",
  "type": "module",
  "bin": {
    "starkfi-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
